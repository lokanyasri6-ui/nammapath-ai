# ---------------------------------------------------------------
# NammaPath AI — environment variables
# Everything is OPTIONAL. With nothing set, the app runs in DEMO MODE:
#   - in-memory report store seeded with clearly-labelled synthetic data
#   - deterministic demo "AI" predictions (labelled as not real inference)
# ---------------------------------------------------------------

# --- AI provider (server-side only; never exposed to the browser) ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase (server-side only) ---
# Project URL from Supabase → Project Settings → API
SUPABASE_URL=
# Service-role key: used ONLY inside Next.js API routes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for report photos (created by the migration)
SUPABASE_PHOTO_BUCKET=report-photos

# --- Moderation ---
# Shared secret for the moderator console (/moderate). Change this!
# In demo mode, if unset, the moderator PIN defaults to "demo-moderator".
MODERATOR_TOKEN=

# --- Rate limiting (per IP, per minute) for AI classification + report creation ---
RATE_LIMIT_PER_MINUTE=12
