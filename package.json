{
  "name": "nammapath-ai",
  "version": "0.1.0",
  "private": true,
  "description": "NammaPath AI \u2014 mobility-aware pedestrian routing with AI-assisted, community-verified barrier reports.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:sql": "esbuild scripts/generate-seed-sql.ts --bundle --platform=node --format=cjs --outfile=.data/gen-seed.cjs --log-level=warning && node .data/gen-seed.cjs",
    "screenshots": "node scripts/screenshots.mjs screenshots"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.460.0",
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
